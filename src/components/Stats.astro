---
import statsVector from "../assets/stats-vector.png";
import StatCard from "./StatCard.astro";
import { Badge } from "./ui/badge";
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));
const stats = t.stats.items;
---

<div class="bg-neutral-950 py-16 md:py-32 px-4 md:px-16 flex flex-col justify-center items-center gap-10 md:gap-20">
  <div class="flex flex-col gap-4 justify-center items-center max-w-3xl px-4">
    <Badge>{t.stats.badge}</Badge>
    <h2 class="text-center font-display text-3xl md:text-5xl font-medium bg-gradient-to-r text-transparent from-[#BDB0F0] via-white to-[#AE5DC7] bg-clip-text">{t.stats.title}</h2>
  </div>
  <div class="flex flex-col md:flex-row gap-4 md:gap-8 relative w-full max-w-5xl px-4">
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 blur-[100px] w-full md:w-[530px] h-[290px] rounded-full bg-radial from-20% from-[#BD66FE] via-40% via-[#5C3AD8] to-[92%] to-[#BD66FE]" />
    <StatCard text={stats[0].text} statText={stats[0].statText} />
    <StatCard text={stats[1].text} statText={stats[1].statText}>
      <img class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 blur-md h-full" src={statsVector.src} alt="stat-vector" />
    </StatCard>
    <StatCard text={stats[2].text} statText={stats[2].statText} />
  </div>
</div>