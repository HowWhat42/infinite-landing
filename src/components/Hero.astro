---
import hero from "../assets/hero.png";
import logoGlassy from "../assets/logo-glassy.png";
import { Badge } from "./ui/badge";
import { Button } from "./ui/button";
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<div>
  <img class="fixed top-0 left-0 w-full h-screen -z-10" src={hero.src} alt="background-hero" fetchpriority="high" />
  <div class="bg-hero fixed bottom-0 right-0 w-full h-screen -z-10" />
  <div class="h-full flex flex-col justify-center">
    <div class="px-4 md:px-16 lg:px-32 my-20 md:my-32 lg:my-52 flex flex-col lg:flex-row justify-between items-center gap-8 lg:gap-0">
      <div class="flex flex-col justify-center items-center lg:items-start gap-6 md:gap-8 w-full lg:w-auto">
        <div class="w-full max-w-[690px] flex flex-col items-center lg:items-start gap-4 md:gap-6">
          <Badge>{t.hero.badge}</Badge>
          <div class="relative text-center lg:text-left w-full">
            <h1 class="absolute font-display shadow-title text-3xl md:text-5xl lg:text-6xl font-medium text-transparent z-[-1]">{t.hero.title}</h1>
            <h1 class="font-display text-3xl md:text-5xl lg:text-6xl font-medium bg-gradient-to-r text-transparent from-[#BDB0F0] via-white to-[#AE5DC7] bg-clip-text">{t.hero.title}</h1>
          </div>

          <p class="text-base md:text-lg text-white/70 font-medium text-center lg:text-left">{t.hero.description}</p>
        </div>
        <div class="flex flex-col md:flex-row items-center gap-4 w-full md:w-auto">
          <div class="relative w-full flex justify-center md:w-auto">
            <div class="absolute z-[-1] -top-4 -left-2 bg-radial from-[#9A7CFF] from-[37%] to-[#0E0AA200] w-[324px] h-[70px] blur-2xl" />
            <Button data-section="contact" size="lg" className="md:w-auto">{t.hero.ctaPrimary}</Button>
          </div>
          <Button data-section="contact" variant="secondary" size="lg" className="md:w-auto">{t.hero.ctaSecondary}</Button>
        </div>
      </div>
      <img class="hidden md:block h-[300px] md:h-[400px] lg:h-full lg:-mb-40" src={logoGlassy.src} alt="logo" fetchpriority="high" />
    </div>
  </div>
</div>