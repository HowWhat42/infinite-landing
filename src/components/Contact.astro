---
import footer from "../assets/footer.png";
import Caldotcom from "./Caldotcom";
import Footer from "./Footer.astro";
import { Badge } from "./ui/badge";
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<div id="contact" class="relative md:min-h-screen pt-20 md:py-40 px-4 md:px-16 flex flex-col items-center gap-10 md:gap-20 -mt-8">
  <img class="absolute top-0 left-0 w-full h-full -z-10" src={footer.src} alt="background-contact" fetchpriority="high" />
  <div class="bg-footer absolute top-0 right-0 w-full h-full -z-10" />
  <div class="flex flex-col gap-4 justify-center items-center max-w-3xl px-4">
    <Badge>{t.contact.badge}</Badge>
    <h1 class="text-center font-display text-3xl md:text-5xl font-medium text-white">{t.contact.title}</h1>
    <p class="text-lg text-white/70 font-normal text-center">{t.contact.description}</p>
  </div>
  
  <div class="w-full">
    <Caldotcom client:idle />
  </div>
  
  <Footer />
</div>