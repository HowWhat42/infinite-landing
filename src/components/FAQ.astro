---
import { Accordion } from "./Accordion";
import { Badge } from "./ui/badge";
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));
const data = t.faq.items;
---

<div id="faq" class="bg-neutral-950 py-16 md:py-32 px-4 md:px-16 flex flex-col justify-center items-center gap-10 md:gap-20 rounded-b-[40px]">
  <div class="flex flex-col gap-4 justify-center items-center max-w-3xl px-4">
    <Badge>{t.faq.badge}</Badge>
    <h1 class="text-center font-display text-3xl md:text-5xl font-medium bg-gradient-to-r text-transparent from-[#BDB0F0] via-white to-[#AE5DC7] bg-clip-text">{t.faq.title}</h1>
    <p class="text-lg text-white/70 font-normal text-center">{t.faq.description}</p>
  </div>
  
  <div class="w-full max-w-3xl space-y-4 px-4">
    <Accordion data={data} client:idle />
  </div>
</div>