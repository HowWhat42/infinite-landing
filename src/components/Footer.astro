---
import { Button } from "./ui/button";
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<div class="md:absolute bottom-0 w-full mt-16 px-4 md:px-16">
  <div class="flex flex-col md:flex-row justify-between items-center border-t border-white/20 py-6 md:py-8 gap-4 md:gap-0">
    <p class="text-white text-sm text-center md:text-left">{t.footer.copyright}</p>
    <div class="flex flex-col md:flex-row gap-4 md:gap-6">
      <Button variant="link">
        {t.footer.privacy}
      </Button>
      <Button variant="link">
        {t.footer.legal}
      </Button>
    </div>
  </div>
</div>