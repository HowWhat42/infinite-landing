---
import AirRental from "../assets/air-rental.png";
import Figue from "../assets/figue.png";
import Mentorshow from "../assets/mentorshow.png";
import Teasquare from "../assets/teasquare.png";
import OnboardMe from "../assets/onboard-me.png";
import TestimonialsCarousel, { type Testimonial } from "./TestimonialsCarousel";
import { Badge } from "./ui/badge";
import { getLangFromUrl, useTranslations } from "../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));
const images = [OnboardMe.src, Figue.src, Mentorshow.src, AirRental.src, Teasquare.src];
const testimonials: Testimonial[] = t.testimonials.items.map((item, i) => ({
  ...item,
  image: images[i],
}));
---

<div class="bg-neutral-950 py-16 md:py-32 px-4 md:px-16 flex flex-col justify-center items-center gap-10 md:gap-20">
  <div class="flex flex-col gap-4 justify-center items-center max-w-3xl px-4">
    <Badge>{t.testimonials.badge}</Badge>
    <h2 class="text-center font-display text-3xl md:text-5xl font-medium bg-gradient-to-r text-transparent from-[#BDB0F0] via-white to-[#AE5DC7] bg-clip-text">{t.testimonials.title}</h2>
    <p class="text-lg text-white/70 font-normal text-center">{t.testimonials.description}</p>
  </div>
  <TestimonialsCarousel testimonials={testimonials} client:load />
</div>
